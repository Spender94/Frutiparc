node_modules/
data/
# La règle `data/` vise le dossier du serveur (scores, sessions…). Les données
# EXTRAITES d'un SWF (scripts/extract-*.js) sont du code : elles se livrent.
#
# CHAQUE PORTAGE DOIT AVOIR SA LIGNE ICI. Sans elle le dossier reste sur la
# machine, le dépôt part sans lui, et le jeu s'ouvre en production sur
# « bibliothèque introuvable » — c'est arrivé à Burning Kiwi. Le test
# portagesLivres.test.js compare désormais le disque au dépôt, portage par
# portage, pour que l'oubli se voie avant la mise en ligne.
!public/kaluga/data/
!public/mb2/data/
!public/bkiwi/data/

# MotionBall 2 daily challenge map — regenerated by the server (boot +
# midnight Paris roll). Tracking it would freeze the map across deploys.
Games/motionBall2/mb2data.dat

# Le BROUILLON : le serveur d'essai et son journal, les sondes Playwright, les
# captures d'écran, les relevés de tests. On y travaille — on y reproduit un
# bogue, on mesure avant et après — mais rien n'y survit à la machine, et rien
# n'y a sa place dans le dépôt. Ce qui mérite de rester devient un test.
scratchpad/
